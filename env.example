# Analytics Ingestion System - Environment Configuration
# Copy this file to env and update with your settings

# ------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'

# ------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------
database.default.DNSv4 = 'pgsql:host=postgres;dbname=analytics'
database.default.username = 'analytics'
database.default.password = 'analytics_password'
database.default.database = 'analytics'
database.default.DBDebug = true
database.default.port = 5432

# ------------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------------
redis.host = 'redis'
redis.port = 6379
redis.password = ''
redis.database = 0

# ------------------------------------------------------------------------
# RABBITMQ
# ------------------------------------------------------------------------
rabbitmq.host = 'rabbitmq'
rabbitmq.port = 5672
rabbitmq.user = 'analytics'
rabbitmq.password = 'analytics_password'
rabbitmq.vhost = '/analytics'

# RabbitMQ Queue Configuration
rabbitmq.exchange = 'analytics.events'
rabbitmq.queue.raw = 'analytics.events.raw'
rabbitmq.queue.dlq = 'analytics.events.dlq'
rabbitmq.dlx = 'analytics.events.dlx'
rabbitmq.routing.key = 'events.raw'

# ------------------------------------------------------------------------
# API SECURITY
# ------------------------------------------------------------------------
api.key = 'your-secret-api-key-change-in-production'
api.rateLimit.requests = 1000
api.rateLimit.window = 60

# ------------------------------------------------------------------------
# EVENT VALIDATION
# ------------------------------------------------------------------------
event.maxBatchSize = 500
event.maxPayloadSize = 1048576  # 1MB in bytes

# Allowed event types
event.allowedTypes = 'page_view,button_click,form_submit,user_signup,logout,session_start,session_end'

# ------------------------------------------------------------------------
# REDIS KEYS
# ------------------------------------------------------------------------
redis.key.prefix.dedupe = 'dedupe:'
redis.key.prefix.rateLimit = 'rl:'
redis.key.prefix.topPages = 'z:top_pages:'
redis.key.prefix.topUsers = 'z:top_users:'
redis.key.prefix.cache = 'cache:'

# ------------------------------------------------------------------------
# TTL SETTINGS (seconds)
# ------------------------------------------------------------------------
dedupe.ttl = 86400           # 24 hours
rateLimit.ttl = 60           # 1 minute
cache.ttl = 120              # 2 minutes
hotMetrics.ttl = 604800      # 7 days

# ------------------------------------------------------------------------
# WORKER CONFIGURATION
# ------------------------------------------------------------------------
worker.prefetchCount = 100
worker.maxRetries = 3
worker.queues = 'analytics.events.raw,analytics.events.retry'

# ------------------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------------------
log.level = 'info'  # debug, info, warning, error
prometheus.enabled = true
prometheus.port = 9090

# ------------------------------------------------------------------------
# ENVIRONMENT
# ------------------------------------------------------------------------
ENVIRONMENT = development
CI_ENVIRONMENT = development
